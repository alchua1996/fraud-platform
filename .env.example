# Copy this file to .env and edit it. Never commit .env.

# Postgres credentials. Use letters and digits only in the password, since it ends up in a URL.
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fraud

# Which model tier 1 uses. builtin:heuristic is the hand-weighted placeholder.
MODEL_PATH=builtin:heuristic

# rules_then_model (rules can block, the model decides the rest) or rules_only.
SCORING_MODE=rules_then_model
REVIEW_THRESHOLD=0.5
BLOCK_THRESHOLD=0.9

# If set, POST /score requires the header "X-API-Key: <value>".
# Always set this on a server that's reachable from the internet.
API_KEY=

# How long to wait for Redis, in seconds (see ticket FRAUD-5).
REDIS_TIMEOUT_S=1.0
